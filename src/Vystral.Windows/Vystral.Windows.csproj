<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Vystral.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vystral.Core\Vystral.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vystral.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Track M: Steam seasonal sale dates as announced by Valve (versioned, with source and retrieval date). -->
    <EmbeddedResource Include="Recap\steam-sales.json" LogicalName="Vystral.Windows.Recap.steam-sales.json" />
  </ItemGroup>
</Project>
